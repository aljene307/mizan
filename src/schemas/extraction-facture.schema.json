{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mizan.example/schemas/extraction-facture.schema.json",
  "title": "Extraction d'une facture ou d'un avoir fournisseur",
  "description": "Champs lus sur le document, tels qu'imprimés (même s'ils sont faux). Tous les champs sont obligatoires ; une information absente vaut null. Montants en nombres décimaux, dans la devise du document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type_document", "numero", "date_facture", "date_echeance", "devise",
    "fournisseur", "client", "lignes",
    "montant_ht", "montant_tva", "droit_timbre", "montant_ttc", "facture_origine_numero"
  ],
  "properties": {
    "type_document": { "enum": ["facture", "avoir"] },
    "numero": { "type": "string", "minLength": 1 },
    "date_facture": { "type": "string", "format": "date" },
    "date_echeance": { "type": ["string", "null"], "format": "date" },
    "devise": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fournisseur": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raison_sociale", "matricule_fiscal", "adresse", "rib"],
      "properties": {
        "raison_sociale": { "type": "string", "minLength": 1 },
        "matricule_fiscal": { "type": ["string", "null"] },
        "adresse": { "type": ["string", "null"] },
        "rib": { "type": ["string", "null"] }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raison_sociale", "matricule_fiscal"],
      "properties": {
        "raison_sociale": { "type": "string", "minLength": 1 },
        "matricule_fiscal": { "type": ["string", "null"] }
      }
    },
    "lignes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["designation", "quantite", "prix_unitaire_ht", "taux_tva", "montant_ht"],
        "properties": {
          "designation": { "type": "string", "minLength": 1 },
          "quantite": { "type": "number", "exclusiveMinimum": 0 },
          "prix_unitaire_ht": { "type": "number", "minimum": 0 },
          "taux_tva": { "type": "number", "minimum": 0, "maximum": 100 },
          "montant_ht": { "type": "number", "minimum": 0 }
        }
      }
    },
    "montant_ht": { "type": "number", "minimum": 0 },
    "montant_tva": { "type": "number", "minimum": 0 },
    "droit_timbre": { "type": ["number", "null"], "minimum": 0 },
    "montant_ttc": { "type": "number", "minimum": 0 },
    "facture_origine_numero": { "type": ["string", "null"] }
  }
}
