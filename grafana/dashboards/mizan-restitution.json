    {
      "id": 11,
      "type": "barchart",
      "title": "TVA figurant sur les factures approuvées, par mois (TND)",
      "description": "Montants imprimés sur les documents approuvés. Ce n'est pas la TVA déductible : la déductibilité relève des textes officiels (D-020, D-068).",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mizan-lecture"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mizan-lecture"
          },
          "rawSql": "SELECT to_char(mois, 'YYYY-MM') AS \"Mois\",\n       sum(montant_tva) FILTER (WHERE type_document = 'facture') AS \"TVA des factures\",\n       coalesce(sum(montant_tva) FILTER (WHERE type_document = 'avoir'), 0) AS \"TVA des avoirs\"\nFROM tva_factures WHERE devise = 'TND' GROUP BY mois ORDER BY mois",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TND",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {}
