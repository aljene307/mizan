      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mizan-lecture"
          },
          "rawSql": "SELECT numero AS \"Facture\", fournisseur AS \"Fournisseur\", to_char(date_echeance, 'YYYY-MM-DD') AS \"Échéance\",\n       reste_a_payer AS \"Reste à payer\", paiement_propose AS \"Au relevé, à confirmer\",\n       etat AS \"État\", jours_de_retard AS \"Jours de retard\", rib_paiement AS \"RIB de paiement (référentiel)\"\nFROM echeancier ORDER BY en_retard DESC, date_echeance NULLS LAST, numero",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
