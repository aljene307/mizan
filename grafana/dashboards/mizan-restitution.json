          "rawSql": "SELECT to_char(semaine, 'YYYY-MM-DD') AS \"Semaine du\", factures AS \"Factures\", sorties_prevues AS \"Sorties prévues\",\n       solde_prevu_fin_semaine AS \"Solde prévu en fin de semaine\"\nFROM tresorerie_prevue ORDER BY semaine",
