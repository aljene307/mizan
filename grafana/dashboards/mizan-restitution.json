      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Données synthétiques.** Paiements toujours sur le RIB du référentiel (D-058). Trésorerie : sorties connues seulement (factures approuvées en TND), sans encaissements ni salaires prévus. TVA : montants **figurant sur les factures** approuvées, **pas la TVA déductible** (règles fiscales non codées, D-020)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reste à payer (TND)",
      "description": "Factures approuvées en TND, hors paiements déjà au relevé en attente de confirmation.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mizan-lecture"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mizan-lecture"
          },
          "rawSql": "SELECT coalesce(sum(reste_a_payer - paiement_propose), 0) AS \"Reste à payer\" FROM echeancier WHERE devise = 'TND'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TND",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      }
    },
