# Copier ce fichier en .env puis remplacer chaque valeur « change-me ».
# Le fichier .env n'est JAMAIS commité (voir .gitignore).
# Générer un secret aléatoire (PowerShell) :
#   -join ((48..57)+(97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})

# --- Versions (fixées pour un environnement reproductible) ---
# Dernière version stable : https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.41.7
POSTGRES_VERSION=18

# --- PostgreSQL ---
POSTGRES_USER=mizan_admin
POSTGRES_PASSWORD=change-me
# Base interne de n8n
POSTGRES_DB=n8n
# Base métier de Mizan (créée par db/init au premier démarrage)
MIZAN_DB=mizan

# --- n8n ---
# Clé de chiffrement des identifiants. La perdre rend les identifiants illisibles.
N8N_ENCRYPTION_KEY=change-me
# Secret partagé entre n8n et le task runner
N8N_RUNNERS_AUTH_TOKEN=change-me
TIMEZONE=Africa/Tunis
